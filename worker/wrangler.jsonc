{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sochlor-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sochlor-keys",
      "database_id": "045938bd-c2dd-4ce0-9906-42e328c70803",
      "migrations_dir": "migrations"
      // database_id is the D1 database wrangler provisioned on this account.
      // If you delete that database, remove the id and the next
      // `wrangler deploy` (even with --dry-run) provisions a new one.
    }
  ]
}
